# 生产环境配置示例
# 复制此文件为 .env 并修改相应的值

# MySQL 配置
MYSQL_ROOT_PASSWORD=your_secure_mysql_password

# Redis 配置
REDIS_PASSWORD=your_secure_redis_password

# JWT 配置 (建议使用更复杂的密钥)
JWT_SECRET=YourSuperSecureJWTSecretKeyForProductionEnvironment2026

# API 基础 URL (根据实际域名修改)
API_BASE_URL=https://api.yourdomain.com

# Spring Profile
SPRING_PROFILES_ACTIVE=prod
