# 生产环境配置示例
# 复制此文件为 .env 并修改相应的值
# 变量名须与 application-prod.yml 中的 ${...} 占位完全一致；
# 这些占位符不设默认值，缺失时应用会启动失败而不是回落到弱口令。

# MySQL 配置
DB_USERNAME=your_db_user
DB_PASSWORD=your_secure_mysql_password

# 容器初始化用（docker-compose 创建 root 口令，需与 DB_PASSWORD 一致）
MYSQL_ROOT_PASSWORD=your_secure_mysql_password

# Redis 配置
REDIS_PASSWORD=your_secure_redis_password

# JWT 配置：至少 32 字节随机串，禁止沿用示例值
JWT_SECRET=YourSuperSecureJWTSecretKeyForProductionEnvironment2026

# 允许的跨域来源（逗号分隔，禁止使用通配符）
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# API 基础 URL (根据实际域名修改)
API_BASE_URL=https://api.yourdomain.com

# Spring Profile
SPRING_PROFILES_ACTIVE=prod
