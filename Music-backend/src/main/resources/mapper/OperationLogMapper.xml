<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC
        "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shanzhu.music.mapper.OperationLogMapper">
    <resultMap id="BaseResultMap" type="com.shanzhu.music.entity.po.OperationLog">
        <id column="id" jdbcType="INTEGER" property="id"/>
        <result column="user_id" jdbcType="INTEGER" property="userId"/>
        <result column="username" jdbcType="VARCHAR" property="username"/>
        <result column="user_type" jdbcType="VARCHAR" property="userType"/>
        <result column="operation_type" jdbcType="VARCHAR" property="operationType"/>
        <result column="module" jdbcType="VARCHAR" property="module"/>
        <result column="description" jdbcType="VARCHAR" property="description"/>
        <result column="request_url" jdbcType="VARCHAR" property="requestUrl"/>
        <result column="request_method" jdbcType="VARCHAR" property="requestMethod"/>
        <result column="request_params" jdbcType="LONGVARCHAR" property="requestParams"/>
        <result column="response_result" jdbcType="LONGVARCHAR" property="responseResult"/>
        <result column="ip_address" jdbcType="VARCHAR" property="ipAddress"/>
        <result column="duration" jdbcType="BIGINT" property="duration"/>
        <result column="status" jdbcType="VARCHAR" property="status"/>
        <result column="error_msg" jdbcType="VARCHAR" property="errorMsg"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
    </resultMap>

    <!-- 列表查询不带两个 TEXT 列：审计列表按页翻看时请求体与响应体没有展示价值，
         取回来只是把整表体积搬进内存和缓存 -->
    <sql id="Base_Column_List">
        id, user_id, username, user_type, operation_type, module, description,
        request_url, request_method, ip_address, duration, status, error_msg, create_time
    </sql>

    <sql id="Detail_Column_List">
        id, user_id, username, user_type, operation_type, module, description,
        request_url, request_method, request_params, response_result,
        ip_address, duration, status, error_msg, create_time
    </sql>

    <insert id="insert" parameterType="com.shanzhu.music.entity.po.OperationLog" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO operation_log (user_id, username, user_type, operation_type, module, description,
                                   request_url, request_method, request_params, response_result,
                                   ip_address, duration, status, error_msg, create_time)
        VALUES (#{userId}, #{username}, #{userType}, #{operationType}, #{module}, #{description},
                #{requestUrl}, #{requestMethod}, #{requestParams}, #{responseResult},
                #{ipAddress}, #{duration}, #{status}, #{errorMsg}, NOW())
    </insert>

    <select id="selectByPrimaryKey" resultMap="BaseResultMap">
        SELECT
        <include refid="Detail_Column_List"/>
        FROM operation_log
        WHERE id = #{id}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM operation_log
        ORDER BY create_time DESC
        LIMIT 500
    </select>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM operation_log
        WHERE user_id = #{userId}
        ORDER BY create_time DESC
        LIMIT 500
    </select>

    <select id="selectByOperationType" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM operation_log
        WHERE operation_type = #{operationType}
        ORDER BY create_time DESC
        LIMIT 500
    </select>

    <delete id="deleteByPrimaryKey">
        DELETE FROM operation_log WHERE id = #{id}
    </delete>

    <delete id="deleteExpiredLogs">
        DELETE FROM operation_log WHERE create_time &lt; DATE_SUB(NOW(), INTERVAL #{days} DAY)
    </delete>

</mapper>
