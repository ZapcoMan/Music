<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC
        "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shanzhu.music.mapper.CollectMapper">
    <resultMap id="BaseResultMap" type="com.shanzhu.music.entity.po.Collect">
        <id column="id" jdbcType="INTEGER" property="id"/>
        <result column="user_id" jdbcType="INTEGER" property="userId"/>
        <result column="type" jdbcType="TINYINT" property="type"/>
        <result column="song_id" jdbcType="INTEGER" property="songId"/>
        <result column="song_list_id" jdbcType="INTEGER" property="songListId"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,user_id,type,song_id,song_list_id,create_time
    </sql>

    <insert id="insert" parameterType="com.shanzhu.music.entity.po.Collect" useGeneratedKeys="true" keyProperty="id">
        insert into collect
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">
                id,
            </if>
            <if test="userId != null">
                user_id,
            </if>
            <if test="type != null">
                type,
            </if>
            <if test="songId != null">
                song_id,
            </if>
            <if test="songListId != null">
                song_list_id,
            </if>
            create_time,
        </trim>
        <trim prefix=" values (" suffix=")" suffixOverrides=",">
            <if test="id != null">
                #{id},
            </if>
            <if test="userId != null">
                #{userId},
            </if>
            <if test="type != null">
                #{type},
            </if>
            <if test="songId != null">
                #{songId},
            </if>
            <if test="songListId != null">
                #{songListId},
            </if>
            now(),
        </trim>
    </insert>

    <delete id="delete">
        delete
        from collect
        where id = #{id}
    </delete>

    <delete id="deleteByUserIdSongId" parameterType="java.lang.Integer">
        delete
        from collect
        where user_id = #{userId}
          and song_id = #{songId}
    </delete>

    <!-- 删除歌曲时级联清理指向它的收藏。
         残留收藏会让热门榜计数、协同过滤与特征统计出现无效数据 -->
    <delete id="deleteBySongId" parameterType="java.lang.Integer">
        delete
        from collect
        where song_id = #{songId}
          and type = 0
    </delete>

    <!-- 删除用户时级联清理其收藏 -->
    <delete id="deleteByUserId" parameterType="java.lang.Integer">
        delete
        from collect
        where user_id = #{userId}
    </delete>

    <select id="allCollect" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from collect
        <!-- 安全上限：全量接口此前无 LIMIT，表一旦增长，单次请求与整份缓存会一起失控。
             真正的分页入口是 allCollectByPage（尚不存在，见 FIX-LOG）（PageHelper），这里只是防无界增长的保险丝。
             当前各表规模远低于该上限，不会截断任何现有数据。 -->
        LIMIT 1000
    </select>

    <select id="collectOfUserId" resultMap="BaseResultMap" parameterType="java.lang.Integer">
        select
        <include refid="Base_Column_List"/>
        from collect
        where user_id = #{userId}
    </select>

    <select id="existSongId" resultType="java.lang.Integer">
        select count(*)
        from collect
        where user_id = #{userId}
          and song_id = #{songId}
    </select>

    <!-- 查询用户收藏的歌曲ID列表 -->
    <select id="selectSongIdsByUserId" resultType="java.lang.Integer" parameterType="java.lang.Integer">
        SELECT song_id FROM collect WHERE user_id = #{userId}
    </select>

    <!-- 查询用户收藏的歌曲（返回Song对象） -->
    <select id="selectByUserId" resultType="com.shanzhu.music.entity.po.Song" parameterType="java.lang.Integer">
        SELECT s.* FROM collect c
        JOIN song s ON c.song_id = s.id
        WHERE c.user_id = #{userId}
    </select>

    <!-- 统计歌曲被收藏的次数 -->
    <select id="countCollectsBySongId" resultType="java.lang.Integer" parameterType="java.lang.Integer">
        SELECT COUNT(*) FROM collect WHERE song_id = #{songId}
    </select>

    <!-- 批量统计多首歌曲被收藏次数：替代推荐流程中的逐首查询 -->
    <select id="countCollectsBySongIds" resultType="java.util.HashMap">
        SELECT song_id AS songId, COUNT(*) AS collectCount
        FROM collect
        WHERE song_id IN
        <foreach collection="songIds" item="songId" open="(" separator="," close=")">
            #{songId}
        </foreach>
        GROUP BY song_id
    </select>

    <!-- 统计歌手的所有歌曲被某用户收藏的总次数 -->
    <select id="countCollectsBySingerId" resultType="java.lang.Integer" parameterType="java.lang.Integer">
        SELECT COUNT(DISTINCT c.id)
        FROM collect c
        JOIN song s ON c.song_id = s.id
        WHERE s.singer_id = #{singerId}
    </select>

</mapper>
















