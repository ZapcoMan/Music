<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC
        "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shanzhu.music.mapper.RankMapper">
    <resultMap id="BaseResultMap" type="com.shanzhu.music.entity.po.Rank" >
        <id column="id" jdbcType="INTEGER" property="id"/>
        <result column="song_list_id" jdbcType="INTEGER" property="songListId"/>
        <result column="consumer_id" jdbcType="INTEGER" property="consumerId"/>
        <result column="score" jdbcType="INTEGER" property="score"/>
    </resultMap>

    <insert id="insert" parameterType="com.shanzhu.music.entity.po.Rank" useGeneratedKeys="true" keyProperty="id">
        insert into `ranks`
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">
                id,
            </if>
            <if test="songListId != null">
                song_list_id,
            </if>
            <if test="consumerId != null">
                consumer_id,
            </if>
            <if test="score != null">
                score,
            </if>
        </trim>
        <trim prefix=" values (" suffix=")" suffixOverrides=",">
            <if test="id != null">
                #{id},
            </if>
            <if test="songListId != null">
                #{songListId},
            </if>
            <if test="consumerId != null">
                #{consumerId},
            </if>
            <if test="score != null">
                #{score},
            </if>
        </trim>
    </insert>

    <!-- 某用户对某歌单的既有评分。唯一键保证至多一行，取一行即可。 -->
    <select id="selectByConsumerAndSongList" resultMap="BaseResultMap">
        select id, song_list_id, consumer_id, score
        from ranks
        where consumer_id = #{consumerId}
          and song_list_id = #{songListId}
    </select>

    <!-- 改分走这条 UPDATE。此前没有它：ranks 带 UNIQUE(song_list_id, consumer_id)，
         Mapper 又只有 insert/delete，第二次提交只能撞唯一键变成"评价失败"。 -->
    <update id="updateScoreByConsumerAndSongList" parameterType="com.shanzhu.music.entity.po.Rank">
        update ranks
        set score = #{score}
        where consumer_id = #{consumerId}
          and song_list_id = #{songListId}
    </update>

    <!-- 删除歌单时级联清理其评分，否则残留评分会继续参与相似度与均值统计 -->
    <delete id="deleteBySongListId" parameterType="java.lang.Integer">
        delete from ranks
        where song_list_id = #{songListId}
    </delete>

    <!-- 删除用户时级联清理其评分，避免相似度计算仍把已注销用户计入 -->
    <delete id="deleteByConsumerId" parameterType="java.lang.Integer">
        delete from ranks
        where consumer_id = #{consumerId}
    </delete>

    <select id="selectScoreSum" resultType="java.lang.Integer" parameterType="java.lang.Integer">
        select COALESCE(sum(score),0) as score
        from ranks
        where song_list_id = #{songListId}
    </select>

    <select id="selectRankNum" resultType="java.lang.Integer" parameterType="java.lang.Integer">
        <!-- 分母用 count(score) 而不是 count(id)：score 列可以为 NULL（V1 建表时未加约束），
             而 sum(score) 会忽略 NULL —— 原先两者口径不一致，
             一条空分行会被计入分母却不计入分子，等于无声把平均分拉低，
             且从响应里完全看不出发生过什么。 -->
        select COALESCE(count(score),0) as num
        from ranks
        where song_list_id = #{songListId}
    </select>

    <!-- 用户评分统计：均值 + 评分次数（置信度）。
         ranks.score 为 1-10 分制，无评分时以中点 5.0 作中性兜底；
         旧值 4.0 是按 5 分制写就的，会把无评分用户压到低于有评分用户，方向相反。 -->
    <select id="selectUserRatingStats" resultType="java.util.HashMap" parameterType="java.lang.Integer">
        SELECT COALESCE(AVG(score), 5.0) AS avgRating,
               COUNT(score)              AS ratingCount
        FROM ranks
        WHERE consumer_id = #{userId}
    </select>

    <!-- 批量查询多首歌曲的评分统计（通过歌单关联），替代推荐流程中的逐首查询。
         没有任何评分记录的歌曲不会出现在结果里，由调用方按中性值兜底。 -->
    <select id="selectRatingStatsBySongIds" resultType="java.util.HashMap">
        SELECT ls.song_id AS songId,
               AVG(r.score) AS avgRating,
               COUNT(r.score) AS ratingCount
        FROM list_song ls
        JOIN ranks r ON r.song_list_id = ls.song_list_id
        WHERE ls.song_id IN
        <foreach collection="songIds" item="songId" open="(" separator="," close=")">
            #{songId}
        </foreach>
        GROUP BY ls.song_id
    </select>

    <!-- 歌曲评分统计：均值 + 评分次数（通过歌单关联） -->
    <select id="selectSongRatingStats" resultType="java.util.HashMap" parameterType="java.lang.Integer">
        SELECT COALESCE(AVG(r.score), 5.0) AS avgRating,
               COUNT(r.score)              AS ratingCount
        FROM ranks r
        JOIN list_song ls ON r.song_list_id = ls.song_list_id
        WHERE ls.song_id = #{songId}
    </select>
</mapper>
















