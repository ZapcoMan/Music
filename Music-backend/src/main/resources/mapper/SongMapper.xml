<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC
        "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shanzhu.music.mapper.SongMapper">
    <resultMap id="BaseResultMap" type="com.shanzhu.music.entity.po.Song" >
        <id column="id" jdbcType="INTEGER" property="id"/>
        <result column="singer_id" jdbcType="VARCHAR" property="singerId"/>
        <result column="name" jdbcType="VARCHAR" property="name"/>
        <result column="introduction" jdbcType="VARCHAR" property="introduction"/>
        <result column="tags" jdbcType="VARCHAR" property="tags"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
        <result column="update_time" jdbcType="TIMESTAMP" property="updateTime"/>
        <result column="pic" jdbcType="VARCHAR" property="pic"/>
        <result column="url" jdbcType="VARCHAR" property="url"/>
    </resultMap>

    <resultMap id="ResultMapWithBLOBs" type="com.shanzhu.music.entity.po.Song" extends="BaseResultMap">
        <result column="lyric" jdbcType="LONGVARCHAR" property="lyric"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,singer_id,name,introduction,tags,create_time,update_time,pic,url
    </sql>

    <sql id="Blob_Column_List">
        id,singer_id,name,introduction,create_time,update_time,pic,lyric,url
    </sql>

    <insert id="insert" parameterType="com.shanzhu.music.entity.po.Song" useGeneratedKeys="true" keyProperty="id">
        insert into song
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">
                id,
            </if>
            <if test="singerId != null">
                singer_id,
            </if>
            <if test="name != null">
                name,
            </if>
            <if test="introduction != null">
                introduction,
            </if>
            <if test="tags != null">
                tags,
            </if>
            create_time,update_time,
            <if test="pic != null">
                pic,
            </if>
            <if test="lyric != null">
                lyric,
            </if>
            <if test="url != null">
                url,
            </if>
        </trim>
        <trim prefix=" values (" suffix=")" suffixOverrides=",">
            <if test="id != null">
                #{id},
            </if>
            <if test="singerId != null">
                #{singerId},
            </if>
            <if test="name != null">
                #{name},
            </if>
            <if test="introduction != null">
                #{introduction},
            </if>
            <if test="tags != null">
                #{tags},
            </if>
            now(),now(),
            <if test="pic != null">
                #{pic},
            </if>
            <if test="lyric != null">
                #{lyric},
            </if>
            <if test="url != null">
                #{url},
            </if>
        </trim>
    </insert>

    <update id="update" parameterType="com.shanzhu.music.entity.po.Song">
        update song
        <set>
            <if test="singerId != null">
                singer_id = #{singerId},
            </if>
            <if test="name != null">
                name = #{name},
            </if>
            <if test="introduction != null">
                introduction = #{introduction},
            </if>
            <if test="tags != null">
                tags = #{tags},
            </if>
            update_time = now(),
            <if test="pic != null">
                pic = #{pic},
            </if>
            <if test="lyric != null">
                lyric = #{lyric},
            </if>
            <if test="url != null">
                url = #{url},
            </if>
        </set>
        where id = #{id}
    </update>

    <delete id="delete" parameterType="java.lang.Integer">
        delete from song
        where id=#{id}
    </delete>

    <select id="selectByPrimaryKey" resultMap="ResultMapWithBLOBs" parameterType="java.lang.Integer">
        select
        <include refid="Blob_Column_List"/>
        from song
        where id=#{id}
    </select>

    <select id="allSong" resultMap="ResultMapWithBLOBs">
        select
        <include refid="Blob_Column_List"/>
        from song
    </select>

    <select id="songOfName" resultMap="ResultMapWithBLOBs" parameterType="java.lang.String">
        select
        <include refid="Blob_Column_List"/>
        from song
        where name = #{name}
    </select>

    <select id="likeSongOfName" resultMap="ResultMapWithBLOBs" parameterType="java.lang.String">
        select
        <include refid="Blob_Column_List"/>
        from song
        where name like #{name}
    </select>

    <select id="songOfSingerId" resultMap="ResultMapWithBLOBs" parameterType="java.lang.Integer">
        select
        <include refid="Blob_Column_List"/>
        from song
        where singer_id = #{singerId}
    </select>
    <!-- 查询语句 -->
    <select id="getSongsByUserIdNotInOtherUser" resultMap="BaseResultMap">
        SELECT s.*
        FROM song s
        WHERE s.id IN (
            SELECT c.song_id
            FROM collect c
            WHERE c.user_id = #{otherUserId}
        )
          AND s.id  Not IN (
            SELECT c.song_id
            FROM collect c
            WHERE c.user_id = #{userId}
        );

    </select>

<select id="getCollectByUserID" resultMap="BaseResultMap">
    SELECT s.id, s.name, s.introduction, s.pic, s.lyric, s.url
    FROM `collect` c
             JOIN `song` s ON c.song_id = s.id
    WHERE c.user_id = #{userId};
</select>

    <!-- 获取用户已播放的歌曲ID列表 -->
    <select id="getPlayedSongIdsByUserId" resultType="java.lang.Integer" parameterType="java.lang.Integer">
        SELECT DISTINCT song_id FROM collect WHERE user_id = #{userId}
    </select>

    <!-- 根据标签相似度查询歌曲 -->
    <select id="getSongsBySimilarTags" resultMap="BaseResultMap">
        SELECT * FROM song 
        WHERE introduction LIKE CONCAT('%', #{tags}, '%')
        ORDER BY RAND()
        LIMIT #{limit}
    </select>

    <!-- 查询热门歌曲 -->
    <select id="getHotSongs" resultMap="BaseResultMap">
        SELECT s.* FROM song s
        LEFT JOIN (
            SELECT song_id, COUNT(*) as play_count FROM collect GROUP BY song_id
        ) c ON s.id = c.song_id
        ORDER BY COALESCE(c.play_count, 0) DESC
        LIMIT #{limit}
    </select>

    <!-- 根据风格查询歌曲 -->
    <select id="getSongsByStyle" resultMap="BaseResultMap">
        SELECT * FROM song 
        WHERE introduction LIKE CONCAT('%', #{style}, '%')
        ORDER BY RAND()
        LIMIT #{limit}
    </select>

</mapper>
















