<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC
        "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shanzhu.music.mapper.SongMapper">
    <resultMap id="BaseResultMap" type="com.shanzhu.music.entity.po.Song" >
        <id column="id" jdbcType="INTEGER" property="id"/>
        <result column="singer_id" jdbcType="VARCHAR" property="singerId"/>
        <result column="name" jdbcType="VARCHAR" property="name"/>
        <result column="introduction" jdbcType="VARCHAR" property="introduction"/>
        <result column="tags" jdbcType="VARCHAR" property="tags"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
        <result column="update_time" jdbcType="TIMESTAMP" property="updateTime"/>
        <result column="pic" jdbcType="VARCHAR" property="pic"/>
        <result column="url" jdbcType="VARCHAR" property="url"/>
    </resultMap>

    <resultMap id="ResultMapWithBLOBs" type="com.shanzhu.music.entity.po.Song" extends="BaseResultMap">
        <result column="lyric" jdbcType="LONGVARCHAR" property="lyric"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,singer_id,name,introduction,tags,create_time,update_time,pic,url
    </sql>

    <sql id="Blob_Column_List">
        id,singer_id,name,introduction,create_time,update_time,pic,lyric,url
    </sql>

    <!-- 召回专用列：不含 lyric（正文可达数 KB，召回候选集不需要），
         也不含 tags（该列由 V2 迁移创建，避免召回路径依赖尚未应用的迁移） -->
    <sql id="Recall_Column_List">
        id,singer_id,name,introduction,create_time,update_time,pic,url
    </sql>

    <insert id="insert" parameterType="com.shanzhu.music.entity.po.Song" useGeneratedKeys="true" keyProperty="id">
        insert into song
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">
                id,
            </if>
            <if test="singerId != null">
                singer_id,
            </if>
            <if test="name != null">
                name,
            </if>
            <if test="introduction != null">
                introduction,
            </if>
            <if test="tags != null">
                tags,
            </if>
            create_time,update_time,
            <if test="pic != null">
                pic,
            </if>
            <if test="lyric != null">
                lyric,
            </if>
            <if test="url != null">
                url,
            </if>
        </trim>
        <trim prefix=" values (" suffix=")" suffixOverrides=",">
            <if test="id != null">
                #{id},
            </if>
            <if test="singerId != null">
                #{singerId},
            </if>
            <if test="name != null">
                #{name},
            </if>
            <if test="introduction != null">
                #{introduction},
            </if>
            <if test="tags != null">
                #{tags},
            </if>
            now(),now(),
            <if test="pic != null">
                #{pic},
            </if>
            <if test="lyric != null">
                #{lyric},
            </if>
            <if test="url != null">
                #{url},
            </if>
        </trim>
    </insert>

    <update id="update" parameterType="com.shanzhu.music.entity.po.Song">
        update song
        <set>
            <if test="singerId != null">
                singer_id = #{singerId},
            </if>
            <if test="name != null">
                name = #{name},
            </if>
            <if test="introduction != null">
                introduction = #{introduction},
            </if>
            <if test="tags != null">
                tags = #{tags},
            </if>
            update_time = now(),
            <if test="pic != null">
                pic = #{pic},
            </if>
            <if test="lyric != null">
                lyric = #{lyric},
            </if>
            <if test="url != null">
                url = #{url},
            </if>
        </set>
        where id = #{id}
    </update>

    <delete id="delete" parameterType="java.lang.Integer">
        delete from song
        where id=#{id}
    </delete>

    <select id="selectByPrimaryKey" resultMap="ResultMapWithBLOBs" parameterType="java.lang.Integer">
        select
        <include refid="Blob_Column_List"/>
        from song
        where id=#{id}
    </select>

    <!-- 供 PageHelper 使用，禁止在本语句里写 LIMIT：
         PageHelper 是在原语句之后追加 LIMIT ?，若原语句已有 LIMIT，
         结果就是 "LIMIT 1000 LIMIT ?" 的语法错误（实测 MySQL 与 H2 均报错）。
         需要上限的全量视图请走下面的 allSongLimited。 -->
    <select id="allSong" resultMap="ResultMapWithBLOBs">
        select
        <include refid="Blob_Column_List"/>
        from song
    </select>

    <!-- 全量视图专用安全上限：不经分页，直接封顶 -->
    <select id="allSongLimited" resultMap="ResultMapWithBLOBs">
        select
        <include refid="Blob_Column_List"/>
        from song
        LIMIT 1000
    </select>

    <select id="songOfName" resultMap="ResultMapWithBLOBs" parameterType="java.lang.String">
        select
        <include refid="Blob_Column_List"/>
        from song
        where name = #{name}
    </select>

    <select id="likeSongOfName" resultMap="ResultMapWithBLOBs" parameterType="java.lang.String">
        select
        <include refid="Blob_Column_List"/>
        from song
        where name like #{name}
    </select>

    <select id="songOfSingerId" resultMap="ResultMapWithBLOBs" parameterType="java.lang.Integer">
        select
        <include refid="Blob_Column_List"/>
        from song
        where singer_id = #{singerId}
    </select>

    <!-- 召回专用：内容召回与个性化召回会按每个偏好歌手各调一次，
         原查询把 lyric 全文一起拉进候选集再丢弃，属纯浪费 -->
    <select id="songOfSingerIdForRecall" resultMap="BaseResultMap" parameterType="java.lang.Integer">
        select
        <include refid="Recall_Column_List"/>
        from song
        where singer_id = #{singerId}
    </select>

    <!-- 召回专用：搜索历史召回按关键词逐个模糊匹配，同样不需要 lyric -->
    <select id="likeSongOfNameForRecall" resultMap="BaseResultMap" parameterType="java.lang.String">
        select
        <include refid="Recall_Column_List"/>
        from song
        where name like #{name}
    </select>

    <!-- 按歌单名召回：用户搜"华语伤感女声"这类词时命中的是歌单而不是歌名，
         此前这条路径完全不存在，导致 type=1 的搜索记录白记 -->
    <select id="likeSongOfListTitleForRecall" resultMap="BaseResultMap" parameterType="java.lang.String">
        <!-- 列必须带 s. 前缀：这里 join 了 list_song 与 song_list，
             三张表都有 id 列，直接复用 Recall_Column_List 的裸 id 会报
             "Column 'id' in field list is ambiguous"（实测踩中） -->
        select s.id, s.singer_id, s.name, s.introduction, s.create_time,
               s.update_time, s.pic, s.url
        from song s
        join list_song ls on ls.song_id = s.id
        join song_list sl on sl.id = ls.song_list_id
        where sl.title like #{title}
    </select>

    <!-- 按专辑名召回：song.introduction 存的就是专辑名 -->
    <select id="likeSongOfIntroductionForRecall" resultMap="BaseResultMap" parameterType="java.lang.String">
        select
        <include refid="Recall_Column_List"/>
        from song
        where introduction is not null
          and introduction like #{introduction}
    </select>
    <!-- 协同过滤召回：相似用户收藏、当前用户未收藏的歌曲，只需召回列 -->
    <select id="getSongsByUserIdNotInOtherUser" resultMap="BaseResultMap">
        SELECT s.id, s.singer_id, s.name, s.introduction, s.create_time,
               s.update_time, s.pic, s.url
        FROM song s
        WHERE s.id IN (
            SELECT c.song_id
            FROM collect c
            WHERE c.user_id = #{otherUserId}
        )
          AND s.id NOT IN (
            SELECT c.song_id
            FROM collect c
            WHERE c.user_id = #{userId}
        )
    </select>

    <select id="getCollectByUserID" resultMap="BaseResultMap">
    SELECT s.id, s.singer_id, s.name, s.introduction, s.pic, s.url, s.create_time, s.update_time
    FROM `collect` c
             JOIN `song` s ON c.song_id = s.id
    WHERE c.user_id = #{userId}
    ORDER BY c.create_time DESC
</select>

    <!-- 获取用户已播放的歌曲ID列表 -->
    <select id="getPlayedSongIdsByUserId" resultType="java.lang.Integer" parameterType="java.lang.Integer">
        SELECT DISTINCT song_id FROM collect WHERE user_id = #{userId}
    </select>

    <!-- 查询热门歌曲 -->
    <select id="getHotSongs" resultMap="BaseResultMap">
        SELECT s.id, s.singer_id, s.name, s.introduction, s.create_time,
               s.update_time, s.pic, s.url
        FROM song s
        LEFT JOIN (
            SELECT song_id, COUNT(*) as play_count FROM collect GROUP BY song_id
        ) c ON s.id = c.song_id
        ORDER BY COALESCE(c.play_count, 0) DESC
        LIMIT #{limit}
    </select>

    <!-- 批量查询歌曲（解决 N+1 问题） -->
    <select id="selectBatchByIds" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM song
        WHERE id IN
        <foreach collection="songIds" item="songId" open="(" separator="," close=")">
            #{songId}
        </foreach>
    </select>

</mapper>
















