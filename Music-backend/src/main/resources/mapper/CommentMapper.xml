<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC
        "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shanzhu.music.mapper.CommentMapper">
    <resultMap id="BaseResultMap" type="com.shanzhu.music.entity.po.Comment" >
        <id column="id" jdbcType="INTEGER" property="id"/>
        <result column="user_id" jdbcType="INTEGER" property="userId"/>
        <result column="type" jdbcType="TINYINT" property="type"/>
        <result column="song_id" jdbcType="INTEGER" property="songId"/>
        <result column="song_list_id" jdbcType="INTEGER" property="songListId"/>
        <result column="content" jdbcType="VARCHAR" property="content"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
        <result column="up" jdbcType="INTEGER" property="up"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,user_id,type,song_id,song_list_id,content,create_time,up
    </sql>

    <insert id="insert" parameterType="com.shanzhu.music.entity.po.Comment" useGeneratedKeys="true" keyProperty="id">
        insert into comment
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">
                id,
            </if>
            <if test="userId != null">
                user_id,
            </if>
            <if test="type != null">
                type,
            </if>
            <if test="songId != null">
                song_id,
            </if>
            <if test="songListId != null">
                song_list_id,
            </if>
            <if test="content != null">
                content,
            </if>
            create_time,
            <if test="up != null">
                up,
            </if>
        </trim>
        <trim prefix=" values (" suffix=")" suffixOverrides=",">
            <if test="id != null">
                #{id},
            </if>
            <if test="userId != null">
                #{userId},
            </if>
            <if test="type != null">
                #{type},
            </if>
            <if test="songId != null">
                #{songId},
            </if>
            <if test="songListId != null">
                #{songListId},
            </if>
            <if test="content != null">
                #{content},
            </if>
            now(),
            <if test="up != null">
                #{up},
            </if>
        </trim>
    </insert>

    <!-- 评论正文发出后不可变（含作者本人），因此持久层不再有整体更新语句。
         唯一允许的写入是点赞自增：加一交给数据库，避免"读出来 +1 再写回"在并发下互相覆盖。
         COALESCE 兼容 MySQL 与测试用的 H2，up 历史行为 null 时也从 1 起算。 -->
    <update id="incrementUp" parameterType="java.lang.Integer">
        update comment
        set up = COALESCE(up, 0) + 1
        where id = #{id}
    </update>

    <delete id="delete" parameterType="java.lang.Integer">
        delete from comment
        where id=#{id}
    </delete>

    <!-- 删除歌曲时级联清理其评论（type=0 歌曲评论） -->
    <delete id="deleteBySongId" parameterType="java.lang.Integer">
        delete from comment
        where song_id=#{songId} and type=0
    </delete>

    <!-- 按歌手批量清理歌曲评论；type=0 同样不可省，歌单评论另有 type=1 -->
    <delete id="deleteBySingerId" parameterType="java.lang.Integer">
        delete from comment
        where song_id in (select id from song where singer_id = #{singerId}) and type=0
    </delete>

    <!-- 删除歌单时级联清理其评论（type=1 歌单评论） -->
    <delete id="deleteBySongListId" parameterType="java.lang.Integer">
        delete from comment
        where song_list_id=#{songListId} and type=1
    </delete>

    <!-- 删除用户时级联清理其发布的评论 -->
    <delete id="deleteByUserId" parameterType="java.lang.Integer">
        delete from comment
        where user_id=#{userId}
    </delete>

    <select id="selectByPrimaryKey" resultMap="BaseResultMap" parameterType="java.lang.Integer">
        select
        <include refid="Base_Column_List"/>
        from comment
        where id=#{id}
    </select>

    <select id="allComment" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from comment
        <!-- 安全上限：全量接口此前无 LIMIT，表一旦增长，单次请求与整份缓存会一起失控。
             真正的分页入口是 allCommentByPage（尚不存在，见 FIX-LOG）（PageHelper），这里只是防无界增长的保险丝。
             当前各表规模远低于该上限，不会截断任何现有数据。 -->
        LIMIT 1000
    </select>

    <select id="commentOfSongId" resultMap="BaseResultMap" parameterType="java.lang.Integer">
        select
        <include refid="Base_Column_List"/>
        from comment
        where song_id = #{songId}
    </select>

    <select id="commentOfSongListId" resultMap="BaseResultMap" parameterType="java.lang.Integer">
        select
        <include refid="Base_Column_List"/>
        from comment
        where song_list_id = #{songListId}
    </select>

    <!-- 查询所有精选评论的内容，供高频词统计。
         两条改动：去掉语句尾分号（数据源配了 filters: stat,wall，
         WallFilter 对多语句形态敏感，留着是潜在的运行期拦截源）；
         加 LIMIT 兜住无界增长——这条的结果会整份进内存做 HanLP 分词，
         评论表一旦长大，先垮的是这一段。
         截断会影响词频统计的代表性，但统计本身是"取前若干条做展示"的性质，
         上限取 1000 与 allCollect 那类保险丝同一口径。 -->
    <select id="selectAllComments" resultType="String">
        SELECT content FROM comment WHERE type = 1 LIMIT 1000
    </select>
    <select id="selectAllCommentsBySongListId" resultType="String" parameterType="String">
         SELECT content FROM comment WHERE type = 1 and song_list_id = #{songListId}
    </select>
</mapper>
















